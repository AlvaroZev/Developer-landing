# Triunder local configuration.
# Copy to .env. Never commit the copy. None of these values belong in source code.

APP_ENV=development
# Public HTTP port for the single-image Dockerfile (nginx). Compose web uses TRIUNDER_WEB_PORT.
PORT=8080
# API listen port when running the Go binary alone. The single-image entrypoint forces 8090.
API_PORT=8080
DATABASE_URL=postgres://triunder:triunder@localhost:5432/triunder?sslmode=disable
# Optional. Defaults to database/migrations locally. In Docker prefer /app/database/migrations.
# The API also embeds migrations, so a missing path no longer blocks startup.
MIGRATIONS_PATH=database/migrations
CORS_ORIGINS=http://localhost:5173
# Pepper for session token hashes. Use at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-string
# Created once, on first boot, when the email is not already registered.
ADMIN_EMAIL=admin@triunder.local
ADMIN_PASSWORD=replace-me
# Development only. Logs password-reset and verification links. Refused when APP_ENV=production.
DEV_MAIL_LOG=true

# Official OpenAI API. Leave the key empty until you are ready.
# The key is read only by the API process and is never returned to browsers.
OPENAI_API_KEY=
# Used when OPENAI_MODEL is empty. gpt-4o-mini is the default.
OPENAI_MODEL=gpt-4o-mini

# Optional Google sign-in. Hidden unless all three values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Frontend dev server proxy. Not baked into the production bundle.
API_PROXY_TARGET=http://localhost:8080
# Leave empty so the browser calls the same origin. Set only when the API lives on another host.
VITE_API_URL=
# Public origin used in development mail links. Docker sets this to the web port.
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Host port for `docker compose` web (default 8080). Override when 8080 is busy.
TRIUNDER_WEB_PORT=8080
# Trust X-Forwarded-For only behind the Triunder proxy. Docker sets this true.
TRUST_PROXY=false
# Optional. Tests can point this at a stand-in. Leave it empty for the official API.
OPENAI_BASE_URL=
