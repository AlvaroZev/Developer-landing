# Triunder environment template — copy to .env and fill values.
# Never commit real secrets.

APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-long-random-string

DATABASE_URL=postgres://triunder:triunder@localhost:5432/triunder?sslmode=disable
POSTGRES_USER=triunder
POSTGRES_PASSWORD=triunder
POSTGRES_DB=triunder

# OpenAI — server-side only. Never expose to the frontend / Vite env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PUBLIC_AI_FEATURES_ENABLED=false

# Frontend (Vite) — public config only
VITE_API_BASE_URL=http://localhost:8080
