{
  "name": "triunder",
  "private": true,
  "version": "0.1.0",
  "description": "Triunder — an interactive engineering showroom.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:report": "node scripts/test-report.mjs",
    "e2e": "pnpm --filter @triunder/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
